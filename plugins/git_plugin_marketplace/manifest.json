{
  "name": "Git Plugin Marketplace",
  "id": "git_plugin_marketplace",
  "version": "1.1.0",
  "author": "Acxel Orozco",
  "description": "Discover, install, update, publish and delete QAH plugins using a Git repository (GitHub) instead of Firebase.",
  "type": "python",
  "category": "development",
  "main": "__init__.py",
  "dependencies": [],
  "icon": "icon.svg",
  "requires_qah": "2.0.8",
  "config": {
    "repository": {
      "owner": "ADOBApps",
      "repo": "qah-git-marketplace",
      "branch": "master"
    },
    "cache_ttl": 300
  },
  "marketplace": {
    "price": 0.0,
    "currency": "USD",
    "price_model": "free",
    "payment_required": false
  },
  "license": {
    "type": "free",
    "max_activations": 100
  }
}